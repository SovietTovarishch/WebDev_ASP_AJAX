@page
@model IndexModel
@* @{
    Layout = null;
    } *@

@* @{
    ViewData["Title"] = "Home page";
    } *@

<div class="form-container">

    <h1>Анкета студента</h1>

    <p class="description">
        Введите свои данные
    </p>

    <form method="post">

        <div class="form-group">
            <label>Имя-фамилия:</label>
            <input type="text" name="Name" placeholder="Введите имя" required>
        </div>

        <div class="form-group">
            <label>Номер телефона:</label>
            <input type="tel" name="Phone" placeholder="+7" required>
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="Email" placeholder="email@example.com" required>
        </div>

        <div class="form-group">
            <label>Специальность:</label>

            <div class="speciality">

                <input type="radio" name="Speciality" value="Программирование" id="dev">
                <label for="dev">Программирование</label>

                <br>

                <input type="radio" name="Speciality" value="Дизайн" id="design">
                <label for="design">Дизайн</label>

                <br>

                <input type="radio" name="Speciality" value="Маркетинг" id="marketing">
                <label for="marketing">Маркетинг</label>

            </div>
        </div>
        <div class="form-group">
            <label for="courses">Курс:</label>
            <select name="Course" id="courses">
                <option value="1 курс">1 курс</option>
                <option value="2 курс">2 курс</option>
                <option value="3 курс">3 курс</option>
                <option value="4 курс">4 курс</option>
            </select>
        </div>
        <div class="form-group">
            <label>Дата рождения:</label>
            <input type="date" name="BirthDate" required>
        </div>
        <div class="form-group">
            <label>Технологии:</label>
            <div class="technologies">
                <input type="checkbox" name="Technologies" value="HTML/CSS" id="html">
                <label for="html">HTML/CSS</label>
                <br>
                <input type="checkbox" name="Technologies" value="JavaScript" id="js">
                <label for="js">JavaScript</label>
                <br>
                <input type="checkbox" name="Technologies" value="C#" id="csharp">
                <label for="csharp">C#</label>
                <br>
                <input type="checkbox" name="Technologies" value="Python" id="python">
                <label for="python">Python</label>
            </div>
        </div>
        <div class="form-group">
            <label for="cities">Город:</label>
            <select name="City" id="cities">
                <option value="Moscow">Москва</option>
                <option value="St_Petersburg">Санкт Петербург</option>
                <option value="Krasnodar">Краснодар</option>
                <option value="Sochi">Сочи</option>
            </select>
        </div>
        <div class="form-group">
            <label for="langs">Основной язык программирования:</label>
            <select name="MainLang" id="langs">
                <option value="html">HTML/CSS</option>
                <option value="js">JavaScript</option>
                <option value="csharp">C#</option>
                <option value="python">Python</option>
            </select>
        </div>
        <div class="form-group">
            <label>Формат обучения:</label>

            <div class="study-form">

                <input type="radio" name="StudyForm" value="Очно" id="ons">
                <label for="ons">Очно</label>

                <br>

                <input type="radio" name="StudyForm" value="Заочно" id="outs">
                <label for="outs">Заочно</label>

                <br>

                <input type="radio" name="StudyForm" value="Дистанционно" id="dist">
                <label for="dist">Дистанционно</label>

            </div>
        </div>
        <div class="form-group">
            <label for="extra-info">Информация о себе:</label>
            <textarea name="ExtraInfo" id="extra-info" placeholder="Дополнительная информация о вас" autocomplete="off"></textarea>
        </div>
        <button class="form-button" type="submit">
            Отправить
        </button>
        <button class="clear-button" type="reset">
            Очистить
        </button>

    </form>

    <div id="status" class="status"></div>

    <div id="result" class="student-card">
        <div class="student-card-header">
            <h2>Анкета отправлена</h2>
            <p>Данные студента</p>
        </div>

        <div class="student-info">
            <div class="info-item">
                <span>Имя:</span>
                <strong id="result-name"></strong>
            </div>
            <div class="info-item">
                <span>Телефон:</span>
                <strong id="result-phone"></strong>
            </div>
            <div class="info-item">
                <span>Email:</span>
                <strong id="result-email"></strong>
            </div>
            <div class="info-item">
                <span>Специальность:</span>
                <strong id="result-speciality"></strong>
            </div>
            <div class="info-item">
                <span>Курс:</span>
                <strong id="result-course"></strong>
            </div>
            <div class="info-item">
                <span>Дата рождения:</span>
                <strong id="result-birthdate"></strong>
            </div>
            <div class="info-item">
                <span>Технологии:</span>
                <strong id="result-technologies"></strong>
            </div>
            <div class="info-item">
                <span>Город:</span>
                <strong id="result-city"></strong>
            </div>
            <div class="info-item">
                <span>Основной язык программирования:</span>
                <strong id="result-mainlang"></strong>
            </div>
            <div class="info-item">
                <span>Формат обучения:</span>
                <strong id="result-studyform"></strong>
            </div>
            <div class="info-item">
                <span>Информация о себе:</span>
                <strong id="result-extrainfo"></strong>
            </div>
        </div>
    </div>
    @if (Model.Message != null)
    {
        <div class="result">
            <h3>Данные анкеты:</h3>

            <p>
                @Model.Message
            </p>
        </div>
    }
    <div class="students-section">
        <h2>Список студентов</h2>
        <div id="students-list"></div>
    </div>
</div>

<script>
    const form = document.querySelector("form");
    const button = form.querySelector("button[type='submit']");
    const status = document.querySelector('#status');

    let isSubmitting = false;

    form.addEventListener("submit", async function(event) {
        event.preventDefault();

        if (isSubmitting) return;

        isSubmitting = true;

        const formData = new FormData(form);

        button.textContent = "Отправка..."
        button.disabled = true;


        await new Promise(resolve => setTimeout(resolve, 2000));

        try {

            const response = await fetch("", {
                method: "POST", 
                body: formData
            }); 

            if (!response.ok) {
                throw new Error("Ошибка сервера");
            }

            const data = await response.json();
            button.textContent = "Анкета успешно отправлена (⌐■_■)"

            document.querySelector("#result-name").textContent = data.Name;
            document.querySelector("#result-phone").textContent = data.Phone;
            document.querySelector("#result-email").textContent = data.Email;
            document.querySelector("#result-speciality").textContent = data.Speciality;
            document.querySelector("#result-course").textContent = data.Course;
            document.querySelector("#result-birthdate").textContent = data.BirthDate;
            document.querySelector("#result-technologies").textContent = data.Technologies;
            document.querySelector("#result-city").textContent = data.City;
            document.querySelector("#result-mainlang").textContent = data.MainLang;
            document.querySelector("#result-studyform").textContent = data.StudyForm;
            document.querySelector("#result-extrainfo").textContent = data.ExtraInfo;

            document.querySelector("#result").style.display = "block";


            status.textContent = "Анкета успешно отправлена"
            console.log(data.Name)
            await new Promise(resolve => setTimeout(resolve, 2000));
        }
        catch(error) {
            status.textContent = "Не удалось отправить анкету"

        }
        finally {
        isSubmitting = false;
        button.disabled = false;
        button.textContent = "Отправить";

        }
    });

    async function loadStudents(){
        
    }

    async function deleteStudent() {

    }

    form.addEventListener("reset", function () {
        document.querySelector('#result').style.display = 'none';
        document.querySelector('#status').textContent = '';
    })
</script>
